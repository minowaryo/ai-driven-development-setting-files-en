# Local development credentials (see docs/credentials/README.md and .claude/rules/40-security.md)
docs/credentials/*
!docs/credentials/README.md

# Local Claude Code settings (personal, machine-specific — never share team-wide permissions here)
.claude/settings.local.json

# Local-only: self-eval harness for this repo's own .claude/ commands (testing the template
# against itself, not something a project that copies .claude/ in needs — kept locally for
# personal experimentation, deliberately not part of the distributed template)
.claude/.claude-plugin/
.claude/evals/

# Build output: standalone entry points extracted for sharing outside this repo, with the
# harness-specific references (Gate numbers, meta/adr paths) stripped. The in-repo version
# stays the source of truth — this is regenerated when someone asks for the file, never
# edited in place (see meta/adr/ADR-0012-skills-vs-commands.md)
dist/

# Local-only: internal training material and the hand-out decks derived from it —
# personal reference material, not part of the distributed template
docs/handbook/
docs/original-docs/*.pptx
